# Padrão: texto normalizado com LF no repositório e na cópia de trabalho
* text=auto eol=lf

# Scripts do Windows precisam de CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binários
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.jar  binary
*.jks  binary
*.keystore binary
*.ttf  binary
*.otf  binary
