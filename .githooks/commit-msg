#!/usr/bin/env bash
# Git commit-msg hook: validates the message before the commit is created.
# Installed by .githooks/install.sh (core.hooksPath). The checks live in
# .githooks/checks/ and are the same scripts CI runs.
set -uo pipefail

msg_file=$1
checks="$(git rev-parse --show-toplevel)/.githooks/checks"
status=0

"$checks/commit-subject.sh" --file "$msg_file" || status=1
"$checks/no-ai-coauthor.sh" --file "$msg_file" || status=1
"$checks/no-emoji.sh" --file "$msg_file" || status=1

if [[ $status -ne 0 ]]; then
    echo "commit-msg: commit rejected. Your message is kept in ${msg_file}." >&2
fi
exit "$status"
